extends ../layouts/default.pug

block title 
  title Thông tin cá nhân

block main 
  h1.box-title Thông tin cá nhân

  //Section 8
  .section-8 
    form(id="profileEditForm")
      .inner-group
        label(for="fullName") Họ tên *
        input(type="text" name="fullName" id="fullName" value="Lê Văn A")

      
      .inner-group
        label(for="email") Email *
        input(type="email" name="email" id="email" value="levana@gmail.com")


      .inner-group
        label(for="phone") Số điện thoại
        input(type="text" name="phone" id="phone")

      
      .inner-group
        label Chức vụ
        input(type="text" value="Giám đốc" readonly)


      .inner-group
        label Nhóm quyền
        input(type="text" value="Quản trị viên" readonly)


      .inner-group.inner-two-col 
        label(for="avatar") Ảnh đại diện
        input(type="file" name="avatar" id="avatar" filepond-image)


      .inner-group.inner-two-col.text-center 
        button Cập nhật
    .inner-link 
      a(href = '#') Đổi mật khẩu


  //End section 8