extends ../layouts/default.pug

block title 
  title Thông tin website

block main 
  h1.box-title Thông tin website

  //Section 8
  .section-8 
    form(id="settingWebsiteInfoForm")
      .inner-group
        label(for="websiteName") Tên website
        input(type="text" name="websiteName" id="websiteName")


      .inner-group
        label(for="phone") Số điện thoại
        input(type="text" name="phone" id="phone")


      .inner-group
        label(for="email") Email
        input(type="email" name="email" id="email")

    
      .inner-group 
        label(for="address") Địa chỉ
        input(type="text" name="address" id="address")

      

      .inner-group
        label(for="logo") Logo
        input(type="file" name="logo" id="logo" filepond-image)


      .inner-group
        label(for="favicon") Favicon
        input(type="file" name="favicon" id="favicon" filepond-image)

      
      .inner-group.inner-two-col.text-center 
        button Cập nhật
    .inner-link 
      a(href = '#') Quay lại danh sách 


  //End section 8