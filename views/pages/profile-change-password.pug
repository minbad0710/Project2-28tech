extends ../layouts/default.pug

block title 
  title Đổi mật khẩu

block main 
  h1.box-title Đổi mật khẩu

  //Section 8
  .section-8 
    form(id="profileChangePasswordForm")
      .inner-group
        label(for="password") Mật khẩu mới
        input(type="password" name="password" id="password")

      
      .inner-group
        label(for="confirmPassword") Nhập lại mật khẩu mới
        input(type="password" name="confirmPassword" id="confirmPassword")


      .inner-group.inner-two-col.text-center 
        button Đổi mật khẩu
  //End section 8