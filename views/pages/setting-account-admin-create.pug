extends ../layouts/default.pug

block title 
  title Tạo tài khoản quản trị

block main 
  h1.box-title Tạo tài khoản quản trị

  //Section 8
  .section-8 
    form(id="settingAccountAdminCreateForm")
      .inner-group
        label(for="fullName") Họ tên *
        input(type="text" name="fullName" id="fullName")

      
      .inner-group
        label(for="email") Email *
        input(type="email" name="email" id="email")


      .inner-group
        label(for="phone") Số điện thoại
        input(type="text" name="phone" id="phone")

      
      .inner-group
        label(for="role") Nhóm quyền
        select(name="role" id="role")
          option(value="value-quan-tri-vien") Quản trị viên
          option(value="value-quan-ly-don-hang") Quản lý đơn hàng

      
      .inner-group
        label(for="positionCompany") Chức vụ
        input(type="text" name="positionCompany" id="positionCompany")

      
      .inner-group
        label(for="status") Trạng thái
        select(name="status" id="status")
          option(value="active") Hoạt động
          option(value="inactive") Tạm dừng

        
      .inner-group 
        label(for="password") Mật khẩu *
        input(type="text" name="password" id="password")


      
      .inner-group.inner-two-col 
        label(for="avatar") Ảnh đại diện
        input(type="file" name="avatar" id="avatar" filepond-image)


      
      .inner-group.inner-two-col.text-center 
        button Tạo mới
    .inner-link 
      a(href = '#') Quay lại danh sách 


  //End section 8