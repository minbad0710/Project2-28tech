doctype html
html(lang = 'en')
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    block title
    link(rel = 'stylesheet' href = 'https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css')
    script(src="https://cdn.tiny.cloud/1/nunk7rd3o8wt6vw4dnbfgaj2dt1b4jrnqrf50jy5o1d3nbf6/tinymce/8/tinymce.min.js" referrerpolicy="origin" crossorigin="anonymous")
    link(href="https://unpkg.com/filepond@^4/dist/filepond.css" rel="stylesheet")
    link(href="https://unpkg.com/filepond-plugin-image-preview/dist/filepond-plugin-image-preview.css" rel="stylesheet")

    link(rel = 'stylesheet' href = 'assets/css/style.css')
    body
      //Header
      include ../partials/header.pug 
      //End Header

      main.main
        //Sider
        include ../partials/sider.pug 
        //End sider

        //Content
        .content
          block main
        //End content
      script(src="https://unpkg.com/filepond@^4/dist/filepond.js")
      script(src="https://unpkg.com/filepond-plugin-image-preview/dist/filepond-plugin-image-preview.js")
      script(src="https://unpkg.com/filepond-plugin-file-validate-type/dist/filepond-plugin-file-validate-type.js")
      script(src="https://cdn.jsdelivr.net/npm/sortablejs@latest/Sortable.min.js") 
      script(src="https://unpkg.com/just-validate@latest/dist/just-validate.production.min.js")
      script(src = "assets/JS/script.js")
